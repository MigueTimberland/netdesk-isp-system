            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreUsuario\": \"cajero890\",\n  \"password\": \"\",\n  \"nombres\": \"Andres\",\n  \"apellidos\": \"Paredes Lopez\",\n  \"identificacion\": \"0102030408\",\n  \"correo\": \"andres.paredes@netdesk.com\",\n  \"telefono\": \"0991112233\",\n  \"rolId\": 3\n}" },
            "url": "{{baseUrl}}/api/usuarios/6"
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"Activo\"\n}" },
            "url": "{{baseUrl}}/api/usuarios/5/estado"
          }
        },
        { "name": "Aprobar", "request": { "method": "POST", "url": "{{baseUrl}}/api/usuarios/5/aprobar" } },
        { "name": "Rechazar", "request": { "method": "POST", "url": "{{baseUrl}}/api/usuarios/5/rechazar" } },
