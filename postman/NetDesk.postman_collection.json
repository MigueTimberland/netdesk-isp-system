{
  "info": {
    "name": "NetDesk ISP",
    "description": "CRUD de caja, usuarios, clientes, turnos, contratos y pagos. El login guarda el JWE en la variable token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const body = pm.response.json();",
                "if (body.token) pm.collectionVariables.set('token', body.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreUsuario\": \"admin123\",\n  \"password\": \"Admin1234\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Recuperar contraseña",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"cajero@netdesk.com\"\n}" },
            "url": "{{baseUrl}}/api/auth/recuperar"
          }
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"cajero@netdesk.com\",\n  \"codigo\": \"PEGARCODIGO\",\n  \"nuevaPassword\": \"Cajero1234\"\n}" },
            "url": "{{baseUrl}}/api/auth/restablecer"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Usuarios",
