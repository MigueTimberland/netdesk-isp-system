        { "name": "Listar", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios" } },
        { "name": "Pendientes", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/pendientes" } },
        { "name": "Cajeros activos", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/por-rol/Cajero" } },
        { "name": "Obtener", "request": { "method": "GET", "url": "{{baseUrl}}/api/usuarios/2" } },
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombreUsuario\": \"cajero890\",\n  \"password\": \"Cajero1234\",\n  \"nombres\": \"Andres\",\n  \"apellidos\": \"Paredes\",\n  \"identificacion\": \"0102030408\",\n  \"correo\": \"andres.paredes@netdesk.com\",\n  \"telefono\": \"0991112233\",\n  \"rolId\": 3\n}" },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Actualizar",
          "request": {
